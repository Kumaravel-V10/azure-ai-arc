        <mxCell id="note-32" value="Frontend services are hosted in a separate resource group and VNet for isolation." style="shape=note;whiteSpace=wrap;html=1;size=14;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;fontSize=10;fontStyle=2;" vertex="1" parent="2">
          <mxGeometry x="2495" y="247" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="note-33" value="Backend services use AKS for microservices and Service Bus for event-driven messaging." style="shape=note;whiteSpace=wrap;html=1;size=14;align=center;verticalAlign=middle;fillColor=#e6ffe6;strokeColor=#d6b656;shadow=1;fontSize=10;fontStyle=2;" vertex="1" parent="2">
          <mxGeometry x="2495" y="342" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="note-34" value="Data layer includes SQL Database for relational data and Redis for caching." style="shape=note;whiteSpace=wrap;html=1;size=14;align=center;verticalAlign=middle;fillColor=#ffe6e6;strokeColor=#d6b656;shadow=1;fontSize=10;fontStyle=2;" vertex="1" parent="2">
          <mxGeometry x="2495" y="437" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="note-35" value="Security services are centralized in a dedicated resource group for compliance and monitoring." style="shape=note;whiteSpace=wrap;html=1;size=14;align=center;verticalAlign=middle;fillColor=#e6f3ff;strokeColor=#d6b656;shadow=1;fontSize=10;fontStyle=2;" vertex="1" parent="2">
          <mxGeometry x="2495" y="532" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="note-36" value="Monitoring services include Application Insights for telemetry and Sentinel for threat detection." style="shape=note;whiteSpace=wrap;html=1;size=14;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;fontSize=10;fontStyle=2;" vertex="1" parent="2">
          <mxGeometry x="2495" y="647" width="280" height="100" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
