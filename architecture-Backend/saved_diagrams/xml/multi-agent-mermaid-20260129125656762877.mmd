    AzurePrivateEndpoints --> agwprodeastus001
    agwprodeastus001 --> AzureStorageTiers
    AzureStorageTiers --> AzureActiveDirectory
    AzureActiveDirectory --> ApplicationGatewayv2
    ApplicationGatewayv2 --> AppServices
    AppServices --> sqldbprodeastus001
    sqldbprodeastus001 --> AzureFirewall

