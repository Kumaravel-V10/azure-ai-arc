    %% Service Connections
    sqldbprodeastus001 --> AzureCDN
    AzureCDN --> agwprodeastus001
    agwprodeastus001 --> AzureSpotVMs
    AzureSpotVMs --> AzureMonitor
    AzureMonitor --> MachineLearning
    MachineLearning --> AppServices
    AppServices --> AzurePrivateEndpoints
    AzurePrivateEndpoints --> AzureKeyVault
    AzureKeyVault --> AzureCacheforRedis
    AzureCacheforRedis --> ApplicationGateway
    ApplicationGateway --> appprodeastus001
    appprodeastus001 --> AzureStorageTiers
    AzureStorageTiers --> KeyVault
    KeyVault --> AzureActiveDirectory
    AzureActiveDirectory --> AzureFirewall
    AzureFirewall --> ApplicationGatewayv2
    ApplicationGatewayv2 --> AzureReservedInstances

