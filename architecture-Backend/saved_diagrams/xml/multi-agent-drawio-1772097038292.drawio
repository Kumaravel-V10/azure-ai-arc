          <mxGeometry x="25" y="1215" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="note-40" value="Tenant Isolation: Separate Application Gateway and App Service per tenant." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;verticalAlign=top;spacingLeft=5;spacingTop=5;size=14;shadow=1;" vertex="1" parent="2">
          <mxGeometry x="25" y="1280" width="280" height="55" as="geometry"/>
