                MicrosoftDefenderforCloud["🔧 Microsoft Defender for Cloud"]
            end
            subgraph ANALYTICS["📊 Analytics"]
                LogAnalyticsWorkspace["🔧 Log Analytics Workspace"]
            end
            subgraph INTEGRATION["🔗 Integration"]
                AzureAPIManagement["🔧 Azure API Management"]
            end
            subgraph MONITORING["📈 Monitoring"]
                ApplicationInsights["🔧 Application Insights"]
                AzureMonitor["🔧 Azure Monitor"]
            end
        end
    end

    %% Architecture Connections
    AzureFrontDoor -->|User HTTPS requests| AzureWebApplicationFirewall(WAF)
    AzureWebApplicationFirewall(WAF) -->|Tenant-specific traffic routing| AzureApplicationGatewayFinnair
    AzureWebApplicationFirewall(WAF) -->|Tenant-specific traffic routing| AzureApplicationGatewayKLM
    AzureApplicationGatewayFinnair -->|Load balancing for Finnair portal| AzureAppServiceFinnairPortal
    AzureApplicationGatewayKLM -->|Load balancing for KLM portal| AzureAppServiceKLMPortal
    AzureAppServiceSharedFunctionApps -->|API calls via Private Endpoint| AzureAPIManagement
    AzureAppServiceSharedFunctionApps -->|SQL queries over Private Link| PostgreSQLFlexibleServer
    AzureAppServiceSharedFunctionApps -->|Cache-aside pattern| AzureRedisCache
    AzureAppServiceSharedFunctionApps -->|Secrets retrieval via Managed Identity| AzureKeyVaultShared
    AzureAppServiceFinnairPortal -->|Secrets retrieval via Managed Identity| AzureKeyVaultFinnair
    AzureAppServiceKLMPortal -->|Secrets retrieval via Managed Identity| AzureKeyVaultKLM
    AzureAppServiceSharedFunctionApps -->|Telemetry & diagnostics| ApplicationInsights
    AzureAppServiceFinnairPortal -->|Telemetry & diagnostics| ApplicationInsights
    AzureAppServiceKLMPortal -->|Telemetry & diagnostics| ApplicationInsights
    vnettestsharedbackendfrasc -->|VNet Peering| vnettestfinnairfrasc
    vnettestsharedbackendfrasc -->|VNet Peering| vnettestklmfrasc

