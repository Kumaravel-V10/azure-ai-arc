                AzureAppServiceFinnairPortal["🔧 Azure App Service - Finnair Portal"]
                AzureAppServiceKLMPortal["🔧 Azure App Service - KLM Portal"]
                AzureAppServiceSharedFunctionApps["⚡ Azure App Service - Shared Function Apps"]
                AzureDNSZones["🔧 Azure DNS Zones"]
                AzureDevOpsPipelines["🔧 Azure DevOps Pipelines"]
            end
            subgraph STORAGE["💾 Storage"]
                AzureStorageFinnair["🔧 Azure Storage - Finnair"]
                AzureStorageKLM["🔧 Azure Storage - KLM"]
                AzureBackup["🔧 Azure Backup"]
            end
            subgraph DATABASE["🗄️ Database"]
                PostgreSQLFlexibleServer["🔧 PostgreSQL Flexible Server"]
                AzureRedisCache["🔧 Azure Redis Cache"]
            end
            subgraph NETWORKING["🌐 Networking"]
                AzureFrontDoor["🔧 Azure Front Door"]
