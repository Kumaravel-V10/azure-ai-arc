graph TB
    subgraph Azure["☁️ Microsoft Azure"]
        subgraph RG["📦 Resource Group"]
            subgraph COMPUTE["⚡ Compute"]
                appprodeastus001["🔧 app-prod-eastus-001"]
                agwprodeastus001["🔧 agw-prod-eastus-001"]
                AzureReservedInstances["🔧 Azure Reserved Instances"]
                AzureActiveDirectory["🔧 Azure Active Directory"]
                AzureSpotVMs["🔧 Azure Spot VMs"]
                AzurePrivateEndpoints["🔧 Azure Private Endpoints"]
                AzureKubernetesService["🔧 Azure Kubernetes Service"]
            end
            subgraph STORAGE["💾 Storage"]
                AzureStorageTiers["🔧 Azure Storage Tiers"]
            end
            subgraph DATABASE["🗄️ Database"]
                AzureCacheforRedis["🔧 Azure Cache for Redis"]
                AzureSQLDatabase["🗃️ Azure SQL Database"]
                sqldbprodeastus001["🔧 sqldb-prod-eastus-001"]
            end
            subgraph NETWORKING["🌐 Networking"]
                AzureFirewall["🔧 Azure Firewall"]
                ApplicationGatewayv2["🚪 Application Gateway v2"]
                AzureFrontDoor["🔧 Azure Front Door"]
            end
            subgraph SECURITY["🔒 Security"]
                AzureKeyVault["🔐 Azure Key Vault"]
            end
        end
    end

    %% Service Connections
    AzureFirewall --> AzureCacheforRedis
    AzureCacheforRedis --> appprodeastus001
    appprodeastus001 --> AzureKeyVault
    AzureKeyVault --> AzureStorageTiers
    AzureStorageTiers --> agwprodeastus001
    agwprodeastus001 --> AzureReservedInstances
    AzureReservedInstances --> AzureActiveDirectory
    AzureActiveDirectory --> ApplicationGatewayv2
    ApplicationGatewayv2 --> AzureSpotVMs
    AzureSpotVMs --> AzureSQLDatabase
    AzureSQLDatabase --> sqldbprodeastus001
    sqldbprodeastus001 --> AzurePrivateEndpoints
    AzurePrivateEndpoints --> AzureKubernetesService
    AzureKubernetesService --> AzureFrontDoor

    %% Azure Styling
    classDef azure fill:#0078d4,stroke:#005a9e,stroke-width:2px,color:#fff
    classDef compute fill:#ff6b35,stroke:#e55100,stroke-width:2px,color:#fff
    classDef storage fill:#00bcf2,stroke:#0288d1,stroke-width:2px,color:#fff
    classDef database fill:#ba68c8,stroke:#8e24aa,stroke-width:2px,color:#fff
    classDef networking fill:#4caf50,stroke:#388e3c,stroke-width:2px,color:#fff
    classDef security fill:#f44336,stroke:#d32f2f,stroke-width:2px,color:#fff
