                MicrosoftDefenderforCloud["🔧 Microsoft Defender for Cloud"]
            end
            subgraph ANALYTICS["📊 Analytics"]
                LogAnalyticsWorkspace["🔧 Log Analytics Workspace"]
            end
            subgraph INTEGRATION["🔗 Integration"]
                AzureAPIManagement["🔧 Azure API Management"]
            end
            subgraph MONITORING["📈 Monitoring"]
                AzureMonitor["🔧 Azure Monitor"]
                ApplicationInsights["🔧 Application Insights"]
            end
        end
    end

    %% Architecture Connections
    AzureFrontDoor -->|User HTTPS requests| AzureWebApplicationFirewall(WAF)
    AzureWebApplicationFirewall(WAF) -->|Tenant-specific traffic routing| AzureApplicationGatewayFinnair
    AzureWebApplicationFirewall(WAF) -->|Tenant-specific traffic routing| AzureApplicationGatewayKLM
    AzureApplicationGatewayFinnair -->|Web application traffic| AzureAppServiceFinnairPortal
    AzureApplicationGatewayKLM -->|Web application traffic| AzureAppServiceKLMPortal
    AzureAppServiceSharedFunctions -->|API calls via Private Endpoint| AzureAPIManagement
    AzureAppServiceSharedFunctions -->|SQL queries over Private Link| PostgreSQLServer
    AzureAppServiceSharedFunctions -->|Cache-aside pattern| RedisCache
    AzureAppServiceSharedFunctions -->|Secrets retrieval via Managed Identity| AzureKeyVaultShared
    AzureAppServiceFinnairPortal -->|Secrets retrieval via Managed Identity| AzureKeyVaultFinnair
    AzureAppServiceKLMPortal -->|Secrets retrieval via Managed Identity| AzureKeyVaultKLM
    AzureMonitor -->|Telemetry & diagnostics| AzureAppServiceSharedFunctions
    AzureMonitor -->|Telemetry & diagnostics| AzureAppServiceFinnairPortal
    AzureMonitor -->|Telemetry & diagnostics| AzureAppServiceKLMPortal
    AzureMonitor -->|Telemetry & diagnostics| PostgreSQLServer
    AzureMonitor -->|Telemetry & diagnostics| RedisCache
    vnettestfrontendfrasc -->|VNet Peering| vnettestsharedbackendfrasc
    AzureAppServiceFinnairPortal -->|Data storage| AzureStorageFinnair
    AzureApplicationGatewayFinnair -->|DNS resolution| AzureDNSZoneFinnair
    AzureAppServiceFinnairPortal -->|Data storage| AzureStorageKLM
    AzureApplicationGatewayKLM -->|DNS resolution| AzureDNSZoneKLM
    AzureAppServiceFinnairPortal -->|Telemetry & diagnostics| ApplicationInsights
    AzureAppServiceFinnairPortal -->|Telemetry & diagnostics| LogAnalyticsWorkspace
    AzureFrontDoor -->|Security monitoring| MicrosoftDefenderforCloud
    AzureAppServiceSharedFunctions -->|Telemetry| AzureMonitor
    AzureAppServiceKLMPortal -->|Telemetry| AzureMonitor

