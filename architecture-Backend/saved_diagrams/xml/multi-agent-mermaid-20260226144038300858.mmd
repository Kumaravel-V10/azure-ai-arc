graph TB
    subgraph Azure["☁️ Microsoft Azure"]
        subgraph RG["📦 Resource Group"]
            subgraph COMPUTE["⚡ Compute"]
                AzureAppServiceFinnairPortal["🔧 Azure App Service - Finnair Portal"]
                AzureDNSZoneFinnair["🔧 Azure DNS Zone - Finnair"]
                AzureAppServiceKLMPortal["🔧 Azure App Service - KLM Portal"]
                AzureDNSZoneKLM["🔧 Azure DNS Zone - KLM"]
                AzureAppServiceSharedFunctions["🔧 Azure App Service - Shared Functions"]
            end
            subgraph STORAGE["💾 Storage"]
                AzureStorageFinnair["🔧 Azure Storage - Finnair"]
                AzureStorageKLM["🔧 Azure Storage - KLM"]
                AzureBackup["🔧 Azure Backup"]
