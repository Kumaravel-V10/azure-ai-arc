    AzureKeyVault --> AppServices
    AppServices --> AzureMonitor
    AzureMonitor --> AzureReservedInstances
    AzureReservedInstances --> MachineLearning
    MachineLearning --> KeyVault
    KeyVault --> appprodeastus001
    appprodeastus001 --> agwprodeastus001
    agwprodeastus001 --> AzureStorageTiers

