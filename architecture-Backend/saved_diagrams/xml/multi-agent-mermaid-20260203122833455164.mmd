    AzureSpotVMs --> AzureFirewall
    AzureFirewall --> ApplicationGateway
    ApplicationGateway --> AzureCDN
    AzureCDN --> ApplicationGatewayv2
    ApplicationGatewayv2 --> AzureCacheforRedis
    AzureCacheforRedis --> AzureActiveDirectory
    AzureActiveDirectory --> sqldbprodeastus001
    sqldbprodeastus001 --> AzurePrivateEndpoints
