                AzureAppServicePlanKLM["🔧 Azure App Service Plan - KLM"]
                AzureFunctions["🔧 Azure Functions"]
                AzureDDoSProtection["🔧 Azure DDoS Protection"]
                AzureAppConfiguration["🔧 Azure App Configuration"]
                AzureTrafficManager["🔧 Azure Traffic Manager"]
            end
            subgraph STORAGE["💾 Storage"]
                AzureBackup["🔧 Azure Backup"]
            end
            subgraph DATABASE["🗄️ Database"]
                AzurePostgreSQL["🔧 Azure PostgreSQL"]
                AzureRedisCache["🔧 Azure Redis Cache"]
            end
            subgraph NETWORKING["🌐 Networking"]
                AzureFrontDoor["🔧 Azure Front Door"]
                AzureApplicationGatewayFinnair["🚪 Azure Application Gateway - Finnair"]
